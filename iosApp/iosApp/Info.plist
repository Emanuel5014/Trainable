<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the AI provider you set up on your local network to read routine sheets.</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Trainable routine</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array><string>com.emanuel5014.trainable.routine</string></array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.emanuel5014.trainable.routine</string>
			<key>UTTypeDescription</key>
			<string>Trainable routine</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.json</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>trainableplan</string></array>
				<key>public.mime-type</key>
				<string>application/vnd.trainable.plan+json</string>
			</dict>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array><string>com.emanuel5014.trainable.autobackup</string></array>
	<key>UIBackgroundModes</key>
	<array><string>processing</string></array>
	<!-- The same background as the first frame of the animated splash (IosSplash.kt) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- trainable:// links from the home-screen widgets (IosWidgetLinks.kt) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.emanuel5014.trainable.widgets</string>
			<key>CFBundleURLSchemes</key>
			<array><string>trainable</string></array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Compose draws at the full refresh rate of ProMotion screens (120 Hz) only with this -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the workout images you choose to export to Photos.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take photos for your routines, sheet scans, and physical checks.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock your physical checks with Face ID.</string>
</dict>
</plist>
