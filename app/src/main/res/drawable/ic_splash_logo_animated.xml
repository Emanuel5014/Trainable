<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon for Android 12+: the two pieces of the logo pop in from small, spinning in opposite
     directions, and settle at slightly different times. Keep the whole thing under
     windowSplashScreenAnimationDuration (700 ms). The static ic_splash_logo is what older versions show. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_logo">

    <target android:name="logo_part_a">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.2"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.2"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="560"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="-35"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="logo_part_b">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="640"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.2"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="640"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.2"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="660"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="rotation"
                    android:valueFrom="35"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="logo_path_a">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="220"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="logo_path_b">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="260"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
